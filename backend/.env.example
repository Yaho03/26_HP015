# Backend 환경 변수 템플릿. 저장소 루트에서 복사해 사용한다:  cp backend/.env.example backend/.env
# .env 는 .gitignore 로 무시되므로 비밀 값은 커밋되지 않는다.

# --- MQTT (Mosquitto) — docker/ 인프라와 동일한 값 ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=hp015
MQTT_PASSWORD=change_me_dev_password

# --- TimescaleDB ---
TIMESCALE_URL=postgresql://hp015:change_me_dev_password@localhost:5432/hp015

# --- CORS (이슈 #105) — 콤마 구분, 와일드카드 금지 ---
CORS_ORIGINS=http://localhost:5173
