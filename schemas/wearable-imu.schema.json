{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hp015.local/schemas/wearable-imu.schema.json",
  "title": "Wearable IMU Data Message",
  "description": "MQTT payload for wearable/{node_id}/imu topic. Contains accelerometer, gyroscope, and fall detection data. QoS 0.",
  "type": "object",
  "required": [
    "schema_version",
    "message_id",
    "node_id",
    "boot_id",
    "sequence",
    "sampled_at",
    "published_at",
    "source_mode",
    "simulation",
    "quality",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.1" },
    "message_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "node_id": { "type": "string", "pattern": "^wearable-\\d{2}$" },
    "boot_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "sampled_at": { "type": "string", "format": "date-time" },
    "published_at": { "type": "string", "format": "date-time" },
    "source_mode": { "type": "string", "enum": ["live", "simulation"] },
    "simulation": {
      "oneOf": [
        {
          "type": "object",
          "required": ["run_id", "scenario_id"],
          "additionalProperties": false,
          "properties": {
            "run_id": { "type": "string" },
            "scenario_id": { "type": "string" }
          }
        },
        { "type": "null" }
      ]
    },
    "quality": {
      "type": "object",
      "required": ["message_status", "time_synced", "sensors"],
      "additionalProperties": false,
      "properties": {
        "message_status": { "type": "string", "enum": ["complete", "partial", "degraded"] },
        "time_synced": { "type": "boolean" },
        "sensors": {
          "type": "object",
          "required": ["mpu-6050"],
          "additionalProperties": false,
          "properties": {
            "mpu-6050": {
              "type": "string",
              "enum": ["valid", "warming_up", "uncalibrated", "error", "not_connected"]
            }
          }
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "accel_x_g",
        "accel_y_g",
        "accel_z_g",
        "accel_magnitude_g",
        "gyro_x_dps",
        "gyro_y_dps",
        "gyro_z_dps",
        "fall_detected"
      ],
      "additionalProperties": false,
      "properties": {
        "accel_x_g": { "type": "number" },
        "accel_y_g": { "type": "number" },
        "accel_z_g": { "type": "number" },
        "accel_magnitude_g": { "type": "number", "minimum": 0 },
        "gyro_x_dps": { "type": "number" },
        "gyro_y_dps": { "type": "number" },
        "gyro_z_dps": { "type": "number" },
        "fall_detected": { "type": "boolean", "description": "Whether a fall was detected in this sample" }
      }
    }
  }
}
