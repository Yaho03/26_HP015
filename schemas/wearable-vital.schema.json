{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hp015.local/schemas/wearable-vital.schema.json",
  "title": "Wearable Vital Data Message",
  "description": "MQTT payload for wearable/{node_id}/vital topic. Contains O2 concentration from SEN0322.",
  "type": "object",
  "required": [
    "schema_version",
    "message_id",
    "node_id",
    "boot_id",
    "sequence",
    "sampled_at",
    "published_at",
    "source_mode",
    "simulation",
    "quality",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.1" },
    "message_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "node_id": { "type": "string", "pattern": "^wearable-\\d{2}$" },
    "boot_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "sampled_at": { "type": "string", "format": "date-time" },
    "published_at": { "type": "string", "format": "date-time" },
    "source_mode": { "type": "string", "enum": ["live", "simulation"] },
    "simulation": {
      "oneOf": [
        {
          "type": "object",
          "required": ["run_id", "scenario_id"],
          "additionalProperties": false,
          "properties": {
            "run_id": { "type": "string" },
            "scenario_id": { "type": "string" }
          }
        },
        { "type": "null" }
      ]
    },
    "quality": {
      "type": "object",
      "required": ["message_status", "time_synced", "sensors"],
      "additionalProperties": false,
      "properties": {
        "message_status": { "type": "string", "enum": ["complete", "partial", "degraded"] },
        "time_synced": { "type": "boolean" },
        "sensors": {
          "type": "object",
          "required": ["sen0322"],
          "additionalProperties": false,
          "properties": {
            "sen0322": {
              "type": "string",
              "enum": ["valid", "warming_up", "uncalibrated", "error", "not_connected"]
            }
          }
        }
      }
    },
    "data": {
      "type": "object",
      "required": ["o2_pct"],
      "additionalProperties": false,
      "properties": {
        "o2_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 30,
          "description": "O2 concentration in percent (SEN0322, ambient air around worker)"
        }
      }
    }
  }
}
