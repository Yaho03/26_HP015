{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hp015.local/schemas/twin-delta.schema.json",
  "title": "Digital Twin Delta Message",
  "description": "WebSocket message for real-time digital twin state updates. Sent by backend to dashboard via WebSocket.",
  "type": "object",
  "required": [
    "type",
    "revision",
    "object_id",
    "physical_id",
    "timestamp",
    "changes"
  ],
  "additionalProperties": false,
  "properties": {
    "type": { "type": "string", "const": "delta" },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Per-object incrementing revision number for ordering"
    },
    "object_id": {
      "type": "string",
      "pattern": "^tw\\.",
      "description": "3D object identifier (tw. prefix)"
    },
    "physical_id": {
      "type": "string",
      "pattern": "^(sensor|wearable)-\\d{2}$",
      "description": "Physical node identifier"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "State change timestamp (ISO 8601 UTC)"
    },
    "changes": {
      "type": "object",
      "description": "Changed fields and their new values",
      "additionalProperties": true
    }
  }
}
