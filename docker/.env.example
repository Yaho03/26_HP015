# docker compose 가 읽는 환경 변수 템플릿.
# docker/.env 로 복사해 실제 값을 채운다:  cp docker/.env.example docker/.env
# docker/.env 는 docker/.gitignore 로 무시된다 (비밀 값 커밋 금지).

# --- TimescaleDB ---
POSTGRES_USER=hp015
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=hp015

# --- Mosquitto (passwordfile 생성 시 사용하는 계정, docker/README.md 참고) ---
MQTT_USERNAME=hp015
MQTT_PASSWORD=change_me_dev_password
