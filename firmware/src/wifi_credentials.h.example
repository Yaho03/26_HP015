#pragma once

// 이 파일을 wifi_credentials.h 로 복사해서 실제 값을 채운다:
//   cp firmware/src/wifi_credentials.h.example firmware/src/wifi_credentials.h
//
// wifi_credentials.h 는 .gitignore 에 등록되어 커밋되지 않는다.
// 펌웨어는 컴파일 시 이 값을 바이너리에 굽는다 — .env 를 읽을 수 없다.
//
// MQTT_* 값은 backend/.env, docker/.env 와 같아야 한다 (이슈 #115).

#define WIFI_SSID     "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

#define MQTT_HOST     "192.168.0.10"
#define MQTT_PORT     1883
#define MQTT_USERNAME "hp015"
#define MQTT_PASSWORD "change_me_dev_password"
